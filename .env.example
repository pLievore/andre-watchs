# ANDRE WATCHES — variáveis de ambiente
#
# Copie para .env.local e preencha. Ver docs/FASE-1.md §1.1 para onde achar
# cada valor no painel do Supabase.

# ── Banco (Supabase) ─────────────────────────────────────────────────────────

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → anon public
# Pode ir ao navegador: respeita RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role
# ⚠️ SEGREDO. Ignora RLS e enxerga tudo. Só no servidor, nunca no cliente.
# Ver docs/BANCO.md, seção "As duas chaves".
SUPABASE_SERVICE_ROLE_KEY=

# ── Contato ──────────────────────────────────────────────────────────────────

# Formato E.164 sem "+", ex.: 5511999999999.
# Vazio = todo CTA cai no Instagram da casa em vez de num número inventado.
NEXT_PUBLIC_WHATSAPP_NUMBER=
