# ANDRE WATCHES — variáveis de ambiente
#
# ⚠️ ESTE ARQUIVO É VERSIONADO. Só nomes, nunca valores.
# Os valores reais vão no .env.local, que o .gitignore protege.
#
# Onde achar cada um: docs/FASE-1.md §1.1.

# ── Supabase: API ────────────────────────────────────────────────────────────

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API Keys → publishable key (o antigo "anon")
# Pode ir ao navegador: respeita RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase: conexão Postgres ───────────────────────────────────────────────
# Project Settings → Database → Connection string
#
# Nenhuma das duas é usada pelo código hoje: as consultas passam pela API do
# Supabase, não por conexão direta. Ficam registradas porque são necessárias se
# um ORM entrar depois (Drizzle, Prisma) e para rodar migração pela linha de
# comando.

# Pooler em modo transação, porta 6543. É a que aplicação serverless usa.
DATABASE_URL=

# Pooler em modo sessão, porta 5432. Para migração — não passa pelo pooler de
# transação, que não suporta comandos de esquema.
DIRECT_URL=

# ── Supabase: escrita ────────────────────────────────────────────────────────

# Project Settings → API Keys → secret key (o antigo "service_role")
# ⚠️ SEGREDO. Ignora RLS e enxerga tudo. Só no servidor, nunca no cliente.
#
# Necessária porque a publishable key respeita RLS, e RLS só permite LEITURA
# (ver docs/BANCO.md). Sem ela, `node scripts/seed-pecas.mjs` não insere nada.
SUPABASE_SECRET_KEY=

# ── Contato ──────────────────────────────────────────────────────────────────

# Formato E.164 sem "+", ex.: 5511999999999.
# Vazio = todo CTA cai no Instagram da casa em vez de num número inventado.
NEXT_PUBLIC_WHATSAPP_NUMBER=
