# Copy to .env.local and fill in values as integrations land (SPEC §2)

# Neon Postgres
DATABASE_URL=

# Cloudflare R2 (storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Better-Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Melhor Envio
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM="NEXUS DROP <no-reply@nexusdrop.com.br>"

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
SENTRY_DSN=
